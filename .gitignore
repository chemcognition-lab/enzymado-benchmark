.agents

.env
.env.*
!.env.example
cluster_env.sh

logs/
scripts/logs/
*.out
# Under results/ only the release trees are versioned; reruns, pilots, seed runs and
# backups stay local, so a broad `git add` cannot sweep them in.
results/*
!results/all_runs.csv
!results/leaderboard_properties.csv
!results/leaderboard_real_case.csv
!results/predictions/
!results/bootstrap/
!results/ratings/
!results/embedding_intersection/
!results/figures/
results/figures/umaps/
# Training-noise seeds: only their test metrics and the tie margins derived from them.
!results/noise_seeds/
results/noise_seeds/**
!results/noise_seeds/**/
!results/noise_seeds/tie_margins_v4.csv
!results/noise_seeds/seed_*/predictions/**/metrics.json
# Published results keep the numbers (metrics, bootstrap, ratings, figures).
# The raw per-run tensors and weights stay local: they are ~820 MB of LFS and
# every number in the paper is recomputable from what is kept.
# Whitelist: only the numbers travel. Weights, tensors and per-epoch logs are
# ~2.5 GB of LFS and every published figure is recomputable from what is kept.
results/predictions/**
!results/predictions/**/
!results/predictions/**/metrics.json
!results/predictions/**/hparams.json
results/evaluation_statistics/
# Historical bootstrap snapshots: kept locally for provenance, not part of
# the release. The canonical numbers live in results/bootstrap/{properties,real_case}.
results/bootstrap/experiments/
results/*_audit_report.json
pytest-of-*/
.claude
Notebook_coding_style.md
Project_coding_style.md

data/embeddings/
data/embeddings_mean_pooled/
*.h5
data/fastas
external/Profluent-E1/
.codex/

# Editor / IDE
.vscode/

# Outputs generated by the data-preparation scripts
results/dataprep_datacards/

# Working notes and agent configuration (not part of the release).
# README images live in assets/ instead, which stays tracked.
docs/
skills/

# Diagram sources stay local: the SVGs carry Inkscape-specific markup and refer
# to rasters by relative path, so only the rendered PNG is published.
assets/**/*.svg
assets/images/

# Local embedding manifests: they hold machine-specific absolute paths.
# Copy the .example.json files and point them at your own embedding store.
embeddings_models_output.json
embeddings_models_output_mean_pooled.json
!embeddings_models_output.example.json
!embeddings_models_output_mean_pooled.example.json

# Figure fonts (Archivo, IBM Plex Mono) live here locally; they are not redistributed.
scripts/figures/fonts/
data/interim/swissprot/
