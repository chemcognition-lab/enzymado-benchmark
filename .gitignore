.venv-*/
venv/
env/
build/
dist/
*.egg-info/

__pycache__
__pycache__/
*.py[cod]
*.pyc
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
